# ── 环境变量 & 密钥（绝不提交）─────────────────────────────
.env
.env.*
!.env.example

# ── 数据目录（本地数据文件）──────────────────────────────
data/

# ── 脚本运行时状态（断点续跑进度 + 备份，不提交）───────────
.funds_progress.json*
# 基金代码 → 公司名映射的 7 天缓存（--fill-company）
.fund_company_map.json
# 一次性生成的缺口清单（可用 SQL 随时重建，很快过期）
fund_gap_codes.txt

# ── Node / 后端 ──────────────────────────────────────────
node_modules/
dist/
# tsx 的转译缓存目录：本机环境下它把缓存根解析成了字面量 "undefined"，
# 于是每次 `npx tsx src/server.ts` 都会在仓库根生成 undefined/temp/tsx-*
undefined/

# ── 前端 (web/) ──────────────────────────────────────────
web/node_modules/
web/dist/
web/.buildtest/
web/src/auto-imports.d.ts
web/src/components.d.ts

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 编辑器 & 系统 ─────────────────────────────────────────
.vscode/
.idea/
.claude/
*.DS_Store
Thumbs.db

# ── 临时文件 ─────────────────────────────────────────────
tmp_*.txt
nul

# ── WorkBuddy 本地数据/记忆（不提交）──────────────────────
.workbuddy/
